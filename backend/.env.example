# Fill locally or supply through deployment environment; never commit real values.
DATABASE_URL=
AUTH_SECRET=
FRONTEND_ORIGIN=
NODE_ENV=
# Production: NODE_ENV=production, HOST=127.0.0.1, PORT=3001.
# FRONTEND_ORIGIN must be the exact HTTPS origin, without /api or trailing slash.
HOST=127.0.0.1
PORT=3001
# false for direct local development; loopback only behind a local trusted proxy.
TRUST_PROXY=false
# Optional assertion only. Never overrides NODE_ENV: production requires true.
COOKIE_SECURE=
# Optional: session duration defaults to 8 hours. PORT defaults to 3001 if unset.
AUTH_SESSION_HOURS=
# Initial bootstrap only: supply these in that command's local session.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional Google OAuth web application. All three values are required to enable it.
# Local callback: http://localhost:3001/public/auth/google/callback
# Production callback: https://your-shop.example/api/public/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: Telegram message to the shop for each new online order.
# Create a bot with @BotFather, then get the chat id of the shop's account or group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
