        "description": "create table \"stockMovement\"",
        "sql": "CREATE TABLE \"public\".\"stockMovement\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"notes\" text,\n  \"productId\" int4 NOT NULL,\n  \"quantity\" numeric NOT NULL,\n  \"quantityInStorageUnit\" numeric NOT NULL,\n  \"reason\" text,\n  \"reference\" text,\n  \"type\" text NOT NULL,\n  \"unit\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"stock_movement_quantity_80c93d85\" CHECK (quantity > 0 AND quantity < 'Infinity'::numeric),\n  CONSTRAINT \"stock_movement_storage_quantity_3ecf1744\" CHECK (\"quantityInStorageUnit\" > 0 AND \"quantityInStorageUnit\" < 'Infinity'::numeric),\n  CONSTRAINT \"stock_movement_type_7394475f\" CHECK (type IN ('ENTRY', 'EXIT', 'ADJUSTMENT_IN', 'ADJUSTMENT_OUT', 'LOSS', 'RETURN_IN')),\n  CONSTRAINT \"stock_movement_unit_f6a80600\" CHECK (unit IN ('KG', 'G', 'L', 'ML', 'PIECE'))\n)",
        "params": []
      }
