    "execute": [
      {
        "description": "create table \"cashMovement\"",
        "sql": "CREATE TABLE \"public\".\"cashMovement\" (\n  \"amount\" numeric NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"movementDate\" text NOT NULL,\n  \"notes\" text,\n  \"paymentMethod\" text NOT NULL,\n  \"purchasePaymentId\" int4,\n  \"reference\" text,\n  \"salePaymentId\" int4,\n  \"sourceId\" int4,\n  \"sourceType\" text NOT NULL,\n  \"type\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"cash_movement_amount_f3043ec0\" CHECK (amount > 0 AND amount < 'Infinity'::numeric),\n  CONSTRAINT \"cash_movement_method_7b70b0f1\" CHECK (\"paymentMethod\" IN ('CASH', 'CARD', 'BANK_TRANSFER', 'CHECK', 'OTHER')),\n  CONSTRAINT \"cash_movement_source_5b454499\" CHECK ((\"sourceType\" = 'SALE_PAYMENT' AND type = 'IN' AND \"sourceId\" IS NOT NULL AND \"salePaymentId\" IS NOT NULL AND \"sourceId\" = \"salePaymentId\" AND \"purchasePaymentId\" IS NULL) OR (\"sourceType\" = 'PURCHASE_PAYMENT' AND type = 'OUT' AND \"sourceId\" IS NOT NULL AND \"purchasePaymentId\" IS NOT NULL AND \"sourceId\" = \"purchasePaymentId\" AND \"salePaymentId\" IS NULL) OR (\"sourceType\" IN ('MANUAL_IN', 'MANUAL_OUT') AND type = CASE WHEN \"sourceType\" = 'MANUAL_IN' THEN 'IN' ELSE 'OUT' END AND \"sourceId\" IS NULL AND \"salePaymentId\" IS NULL AND \"purchasePaymentId\" IS NULL AND \"paymentMethod\" = 'CASH'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"cashMovement\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"cashMovement\""
        ]
      }
    ]
