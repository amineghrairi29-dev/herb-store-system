    "execute": [
      {
        "description": "create table \"onlineOrder\"",
        "sql": "CREATE TABLE \"public\".\"onlineOrder\" (\n  \"cancelledAt\" timestamptz,\n  \"confirmedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"customerEmail\" text,\n  \"customerName\" text NOT NULL,\n  \"customerPhone\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"notes\" text,\n  \"reference\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"totalAmount\" numeric NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"online_order_status_e490f5ea\" CHECK ((status = 'PENDING' AND \"confirmedAt\" IS NULL AND \"cancelledAt\" IS NULL) OR (status = 'CONFIRMED' AND \"confirmedAt\" IS NOT NULL AND \"cancelledAt\" IS NULL) OR (status = 'CANCELLED' AND \"cancelledAt\" IS NOT NULL AND \"confirmedAt\" IS NULL)),\n  CONSTRAINT \"online_order_total_cb431b28\" CHECK (\"totalAmount\" > 0 AND \"totalAmount\" < 'Infinity'::numeric)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"onlineOrder\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"onlineOrder\""
        ]
      }
    ]
  },
