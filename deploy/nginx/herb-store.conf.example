# Replace ALL placeholders; include in nginx's http context, then run nginx -t.
# The only public listener is nginx. Node and PostgreSQL stay private.
# Log the path only: order lookups can contain personal data in query parameters.
log_format herb_store '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 308 https://YOUR_DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;
    ssl_certificate /PATH_TO_CERTIFICATE/fullchain.pem;
    ssl_certificate_key /PATH_TO_CERTIFICATE/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/herb-store-access.log herb_store;
    error_log /var/log/nginx/herb-store-error.log warn;
    client_max_body_size 100k;

    # Overwrite untrusted incoming forwarding headers at this single edge proxy.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_read_timeout 65s;

    location = /api { return 308 /api/; }
    location /api/ {
        # Trailing slash strips /api/: /api/auth/me becomes /auth/me.
        proxy_pass http://127.0.0.1:BACKEND_PORT/;
    }
    location / {
        proxy_pass http://127.0.0.1:FRONTEND_PORT;
        proxy_buffering off;
    }
    # App layers own security headers. Do not duplicate CSP/HSTS here.
    # Activate this TLS vhost only after the certificate/HTTPS setup is valid.
}
