[Unit]
Description=Herb Store frontend
After=network.target

[Service]
Type=simple
User=SERVICE_USER
Group=SERVICE_GROUP
WorkingDirectory=/ABSOLUTE_RELEASE_PATH/frontend
EnvironmentFile=/ABSOLUTE_PRIVATE_ENV_PATH/frontend.env
Environment=NODE_ENV=production
ExecStart=/ABSOLUTE_NODE_PATH/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
