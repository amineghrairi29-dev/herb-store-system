# Required for production build/start; public URL, never a secret.
NEXT_PUBLIC_API_BASE_URL=
# Development: http://localhost:3001
# Production: https://YOUR_DOMAIN/api (replace placeholder before build).
# Build-time value: rebuild if it changes. Legacy NEXT_PUBLIC_API_URL still works.
# Do not put DATABASE_URL, AUTH_SECRET or any private key in frontend env files.
